# Sao chép thành .env (KHÔNG commit). Chỉ dùng dữ liệu mẫu khi chạy bản miễn phí của Gemini.
# FAKE_LLM=1: agent mẫu theo từ khóa. FAKE_LLM=0: dùng Gemini (cần GEMINI_API_KEY)
FAKE_LLM=0
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBED_MODEL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=doi-mat-khau-nay
RATE_LIMIT_PER_MIN=15
HOTLINE=0888.566.599
COOKIE_SECURE=0
TZ=Asia/Ho_Chi_Minh
# Trang quản trị: 0 = vào thẳng, không đăng nhập (chỉ dùng nội bộ/máy local). 1 = bắt buộc đăng nhập
ADMIN_AUTH=0
# Nạp vài đơn hàng mẫu (SV100001...) để thử tra cứu. Đặt 0 khi nối hệ thống đơn hàng thật
SEED_DEMO_ORDERS=1
# Chỉ cần khi nhúng widget vào web ở tên miền khác, ví dụ: https://savani.vn,https://www.savani.vn
CORS_ORIGINS=
